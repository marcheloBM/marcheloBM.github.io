</XMBML>This file was added in 3.2.2 for disabling auto-updates as default# PS3HEN Global Config File

[global]
version=3.5.0

[browser]
clear_web_auth_cache=0
clear_web_cookie=0
clear_web_history=0

[debug]
# lan,wifi,toggle
transport=toggle
wifi_ip=192.168.5.70
wifi_port=18194
# multicast, unicast
wifi_target_mode=multicast
wifi_multicast_ip=239.255.18.194

[development]
# Build Types [release, dev]
# HEN Modes [release, debug, usb]
build_type=release
hen_mode=release
quick_preview=0
trigger_hen_install=0

[mappath]
app_home=0
disable_remaps_on_next_boot=0

[psn]
clear_ci=0
clear_mi=0
clear_ptl=0

[patches]
lib_audio=0

[pkg_manager]
pkg_install_99=0

[server]
base_url=http://ps3xploit.me
hen_version=/hen/hen_version.bin
hen_version_dev=/hen/hen_version_dev.bin
hfw_pup_path=/firmware/xmbupdater/PS3UPDAT.PUP

[updates]
