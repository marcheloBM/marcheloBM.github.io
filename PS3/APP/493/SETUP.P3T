	<View id="root">
		<Attributes>
		<!-- Focus on boot -->
			<Table key="hen_xmb">
				<Pair key="focus_priority"><String>-80</String></Pair>
			</Table>
		<!-- Focus on HEN Enabled -->
			<!--<Table key="hen_disabled_xmb">
				<Pair key="focus_priority"><String>-80</String></Pair>
			</Table>-->
		<!-- Focus if HEN icon hidden -->
			<Table key="seg_package_files">
				<Pair key="focus_priority"><String>-80</String></Pair>
			</Table>
		</Attributes>
		<Items>
			<Query
				class="type:x-xmb/folder-pixmap"
				key="seg_fixed_items"
				src="#seg_fixed_items"
				/>
			<Query
				class="type:x-xmb/folder-pixmap"
				key="seg_sdps2"
				src="sel://localhost/ps2emusave?category_game.xml#seg_sdps2"
				/>
			<Query
				class="type:x-xmb/folder-pixmap"
				key="seg_fixed_items2"
				src="#seg_fixed_items2"
				/>
			<!-- HEN Enabler Default HDD -->
			<Query
				class="type:x-xmb/folder-pixmap"
				key="hen_xmb"
				attr="hen_xmb"
				src="xmb://localhost/dev_hdd0/hen_enable.xml#hen_xmb"
				/>
