<XMBML version="1.0">
	<View id="root">
		<Attributes>
			<Table key="view_photo">
				<Pair key="month"><String>xcb://localhost/query?ssort=root.view_sort_selected.photo_month&cond=Ae+PhotoList:PhotoList.type %xCB_LIST_TYPE_PHOTO_ALBUM_MONTH</String></Pair>
				<Pair key="year"><String>xcb://localhost/query?ssort=root.view_sort_selected.photo_year&cond=Ae+PhotoList:PhotoList.type %xCB_LIST_TYPE_PHOTO_ALBUM_YEAR</String></Pair>
				<Pair key="album"><String>xcb://localhost/query?sort=+PhotoList:Common.titleForSort&cond=Ae+PhotoList:PhotoList.type %xCB_LIST_TYPE_PHOTO_TAGS</String></Pair>
				<Pair key="all"><String>xcb://localhost/query?ssort=root.sort_selected.photo_all&cond=Aa+Photo:Photo.codec</String></Pair>
			</Table>

			<Table key="view_music">
				<Pair key="album"><String>xcb://localhost/query?ssort=root.view_sort_selected.music_album&cond=Ae+MusicList:MusicList.type %xCB_LIST_TYPE_MUSIC_ALBUM</String></Pair>
				<Pair key="artist"><String>xcb://localhost/query?sort=+MusicList:Common.titleForSort&cond=Ae+MusicList:MusicList.type %xCB_LIST_TYPE_MUSIC_PLAYLIST_ARTIST</String></Pair>
				<Pair key="genre"><String>xcb://localhost/query?sort=+MusicList:MusicListServed.genreForSort&cond=Ae+MusicList:MusicList.type %xCB_LIST_TYPE_MUSIC_PLAYLIST_GENRE</String></Pair>
				<Pair key="track_initial"><String>xcb://localhost/query?sort=+MusicList:Common.titleForSort&cond=Ae+MusicList:MusicList.type %xCB_LIST_TYPE_MUSIC_TRACKNAME_INITIAL</String></Pair>
				<Pair key="year"><String>xcb://localhost/query?ssort=root.view_sort_selected.music_year&cond=Ae+MusicList:MusicList.type %xCB_LIST_TYPE_MUSIC_RELEASEDYEAR</String></Pair>
				<Pair key="all"><String>xcb://localhost/query?ssort=root.sort_selected.music_all&cond=Aa+Music:Music.codec</String></Pair>
			</Table>

			<Table key="view_video">
				<Pair key="title_initial"><String>xcb://localhost/query?sort=+VideoList:Common.titleForSort&cond=Ae+VideoList:VideoList.type %xCB_LIST_TYPE_VIDEO_TITLE_INITIAL</String></Pair>
				<Pair key="imported_month"><String>xcb://localhost/query?sort=+VideoList:Common.titleForSort&cond=Ae+VideoList:VideoList.type %xCB_LIST_TYPE_VIDEO_IMPORTEDMONTH</String></Pair>
				<Pair key="album"><String>xcb://localhost/query?sort=+VideoList:Common.titleForSort&cond=Ae+VideoList:VideoList.type %xCB_LIST_TYPE_VIDEO_TAGS</String></Pair>
				<Pair key="all"><String>xcb://localhost/query?ssort=root.sort_selected.video_all&cond=Aa+Video:Video.videoCodec</String></Pair>
			</Table>

			<Table key="view_vmc">
				<Pair key="all"><String>xcb://localhost/query?ssort=root.sort_selected.vmc_all&limit=2048</String></Pair>
			</Table>

			<Table key="view_savedata_ps2">
				<Pair key="all"><String>xcb://localhost/query?ssort=root.sort_selected.savedata_ps2_all&limit=2048</String></Pair>
			</Table>

			<Table key="view_savedata_psp">
				<Pair key="title"><String>xcb://localhost/query?sort=+GameList:Common.titleForSort&cond=Ae+GameList:GameList.type %xCB_LIST_TYPE_PSPSAVEDATA_TITLE+Ae+GameList:Common.owner %xUserId&limit=2048</String></Pair>
				<Pair key="all"><String>xcb://localhost/query?ssort=root.sort_selected.savedata_psp_all&cond=Ap+PspSaveData:Common.dirPath %xUserHomeDir/minis_savedata+Ae+PspSaveData:Common.owner %xUserId&limit=2048</String></Pair>
			</Table>

			<Table key="view_savedata_ps3">
				<Pair key="title"><String>xcb://localhost/query?sort=+GameList:Common.titleForSort&cond=Ae+GameList:GameList.type %xCB_LIST_TYPE_PS3SAVEDATA_TITLE+Ae+GameList:Common.owner %xUserId&limit=2048</String></Pair>
				<Pair key="all"><String>xcb://localhost/query?ssort=root.sort_selected.savedata_ps3_all&cond=Ap+Ps3SaveData:Common.dirPath %xUserHomeDir/savedata+Ae+Ps3SaveData:Common.owner %xUserId&limit=2048</String></Pair>
			</Table>

			<Table key="view_savedata_plus">
				<Pair key="title"><String>xcb://localhost/query?table=MMS_MEDIA_TYPE_PLUS&sort=+GameList:Common.titleForSort&cond=Ae+GameList:Common.owner %xUserId+Ae+GameList:GameList.type %xCB_LIST_TYPE_PS3SAVEDATA_TITLE&limit=2048&opt=option_plus</String></Pair>
				<Pair key="all"><String>xcb://localhost/query?table=MMS_MEDIA_TYPE_PLUS&subclass=x-xcb/savedata-plus&ssort=root.sort_selected.savedata_plus_all&cond=Ae+Ps3SaveData:Common.owner %xUserId&limit=2048</String></Pair>
			</Table>

			<Table key="view_game">
				<Pair key="format"><String>xcb://localhost/query?limit=2048&sort=+GameList:Common.titleForSort&scond=root.cond_selected.gamelist_format</String></Pair>
				<Pair key="tags"><String>xcb://localhost/query?limit=2048&sort=+GameList:Common.titleForSort&cond=Ae+GameList:GameList.type %xCB_LIST_TYPE_GAME_TAGS</String></Pair>
				<Pair key="all"><String>xcb://localhost/query?limit=2048&ssort=root.sort_selected.game_all&limit=2048&scond=root.cond_selected.game_all</String></Pair>
			</Table>

			<Table key="view_friend">
				<Pair key="all"><String>xcb://localhost/query?table=MMS_MEDIA_TYPE_SYSTEM&ssort=root.sort_selected.friend_all&cond=Aa+Person:Common.titleForSort+AGL+Person:Common.stat.status 2 5</String></Pair>
			</Table>

			<Table key="view_trophy_title">
				<Pair key="all"><String></String></Pair>
			</Table>

			<Table key="view_trophy">
				<Pair key="all"><String></String></Pair>
				<Pair key="group"><String></String></Pair>
			</Table>

			<Table key="view_trophy_ex">
				<Pair key="all"><String></String></Pair>
				<Pair key="group"><String></String></Pair>
			</Table>

			<Table key="cond_trophy">
				<Pair key="default"><String></String></Pair>
				<Pair key="default_ex"><String></String></Pair>
				<Pair key="unlocked"><String></String></Pair>
				<Pair key="unlocked_ex"><String></String></Pair>
				<Pair key="show"><String></String></Pair>
				<Pair key="show_ex"><String></String></Pair>
			</Table>

			<Table key="cond_trophy2">
				<Pair key="default"><String></String></Pair>
				<Pair key="default_ex"><String></String></Pair>
				<Pair key="unlocked"><String></String></Pair>
				<Pair key="unlocked_ex"><String></String></Pair>
				<Pair key="show"><String></String></Pair>
				<Pair key="show_ex"><String></String></Pair>
			</Table>

			<Table key="view_friendtrophy_title">
				<Pair key="all"><String>xcb://localhost/query?limit=2048&table=MMS_MEDIA_TYPE_SYSTEM&subclass=x-xcb/friendachievtitle&cond=Aa+AchievTitle:Common.titleForSort&ssort=root.sort_selected.friendtrophy_title_all</String></Pair>
			</Table>

			<Table key="view_friendtrophy">
				<Pair key="all"><String>xcb://localhost/query?limit=2048&table=MMS_MEDIA_TYPE_SYSTEM&subclass=x-xcb/friendachievflag&cond=Aa+AchievFlag:AchievFlag.reserved3+Aa+AchievFlag:Common.titleForSort&ssort=root.sort_selected.friendtrophy_all</String></Pair>
				<Pair key="group"><String>xcb://localhost/query?limit=2048&table=MMS_MEDIA_TYPE_SYSTEM&subclass=x-xcb/friendachievgroup&cond=Aa+AchievFlag:AchievFlag.reserved0+Aa+AchievFlag:Common.titleForSort&ssort=root.sort_selected.friendtrophy_group_all</String></Pair>
			</Table>

			<Table key="view_selected">
				<Pair key="photo"><String>view_photo.month</String></Pair>
				<Pair key="music"><String>view_music.album</String></Pair>
				<Pair key="video"><String>view_video.all</String></Pair>
				<Pair key="vmc"><String>view_vmc.all</String></Pair>
				<Pair key="savedata_ps2"><String>view_savedata_ps2.all</String></Pair>
				<Pair key="savedata_psp"><String>view_savedata_psp.all</String></Pair>
				<Pair key="savedata_ps3"><String>view_savedata_ps3.all</String></Pair>
				<Pair key="savedata_plus"><String>view_savedata_plus.all</String></Pair>
				<Pair key="game"><String>view_game.all</String></Pair>
				<Pair key="game_tool"><String>view_game.all_tool</String></Pair>
				<Pair key="friend"><String>view_friend.all</String></Pair>
				<Pair key="trophy_title"><String>view_trophy_title.all</String></Pair>
				<Pair key="trophy"><String>view_trophy.all</String></Pair>
				<Pair key="trophy_ex"><String>view_trophy_ex.all</String></Pair>
				<Pair key="friendtrophy_title"><String>view_friendtrophy_title.all</String></Pair>
				<Pair key="friendtrophy"><String>view_friendtrophy.all</String></Pair>
			</Table>

			<Table key="cond_gamelist">
				<Pair key="format_default"><String>cond=Ae+GameList:GameList.type %xCB_LIST_TYPE_GAME_FORMAT</String></Pair>
				<Pair key="format_but_1p_pp"><String>cond=Ae+GameList:GameList.type %xCB_LIST_TYPE_GAME_FORMAT+An+GameList:Common.titleForSort 2000+An+GameList:Common.titleForSort 4000</String></Pair>
